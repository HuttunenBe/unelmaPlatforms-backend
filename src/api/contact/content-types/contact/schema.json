{
  "kind": "collectionType",
  "collectionName": "contacts",
  "info": {
    "singularName": "contact",
    "pluralName": "contacts",
    "displayName": "Contact"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "required": true
    },
    "phone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 30
    },
    "email": {
      "type": "email",
      "required": true,
      "minLength": 5,
      "maxLength": 254
    },
    "message": {
      "type": "text",
      "minLength": 5,
      "maxLength": 2000,
      "required": true
    },
    "date": {
      "type": "datetime"
    }
  }
}
